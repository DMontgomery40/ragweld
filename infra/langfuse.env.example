# Langfuse v4 application environment — committed DEV DEFAULTS.
#
# This file is loaded first by the `langfuse` and `langfuse-worker` Compose
# services; the gitignored `infra/langfuse.env` is loaded second and
# overrides anything here (same pattern as infra/litellm.env).
#
# SECURITY: `./start.sh` generates infra/langfuse.env with per-machine random
# secrets BEFORE first boot, so a normal launch never runs on these committed
# values. They only apply if you bypass start.sh with a bare `docker compose
# up` — Langfuse stores full prompts/outputs, so do NOT do that anywhere a
# repository-known credential matters, and rotate by regenerating
# infra/langfuse.env before the first boot (the LANGFUSE_INIT_* values are
# only applied to an empty database).

# --- Core ---
DATABASE_URL=postgresql://langfuse:langfuse@langfuse-postgres:5432/langfuse
SALT=ragweld-dev-salt-not-a-secret
ENCRYPTION_KEY=0e2ac9857cbe6a53e5ee2b8ff29676dcb0b26b5b2ae2866c5e07817ea23d9c30
NEXTAUTH_SECRET=ragweld-dev-nextauth-secret
NEXTAUTH_URL=http://127.0.0.1:53000
TELEMETRY_ENABLED=false

# --- ClickHouse (analytics store) ---
CLICKHOUSE_URL=http://langfuse-clickhouse:8123
CLICKHOUSE_MIGRATION_URL=clickhouse://langfuse-clickhouse:9000
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=langfuse
CLICKHOUSE_CLUSTER_ENABLED=false

# --- Redis (queue) ---
REDIS_HOST=langfuse-redis
REDIS_PORT=6379
REDIS_AUTH=langfuse

# --- MinIO (event blob storage, S3-compatible) ---
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=langfuse-minio
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://langfuse-minio:9000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true

# --- Headless provisioning ---
# Provisions the org/project/API keys on first boot so the host API's
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY work without a UI signup step.
# Override the keys and password in infra/langfuse.env for a real deployment.
LANGFUSE_INIT_ORG_ID=ragweld
LANGFUSE_INIT_ORG_NAME=Ragweld
LANGFUSE_INIT_PROJECT_ID=ragweld
LANGFUSE_INIT_PROJECT_NAME=ragweld
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-ragweld-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-ragweld-dev
LANGFUSE_INIT_USER_EMAIL=operator@ragweld.local
LANGFUSE_INIT_USER_NAME=Ragweld Operator
LANGFUSE_INIT_USER_PASSWORD=ragweld-operator
