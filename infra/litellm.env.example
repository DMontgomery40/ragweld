# Safe disabled default for clean installs. Copy to infra/litellm.env and replace
# the value only when running the explicit paid smoke alias.
OPENROUTER_API_KEY=disabled
# Native OpenAI embeddings use the gateway's upstream key, never the app's.
OPENAI_API_KEY=disabled

# Native spend accounting never persists request/response payloads.
STORE_PROMPTS_IN_SPEND_LOGS=false

# Applies before provider SDK clients capture their import-time retry defaults.
DEFAULT_MAX_RETRIES=0

# Private provisioning copies the existing Langfuse project's keys to litellm.env.
# Disabled defaults never select a hosted trace destination.
LANGFUSE_PUBLIC_KEY=disabled
LANGFUSE_SECRET_KEY=disabled
LANGFUSE_OTEL_HOST=http://langfuse:3000
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
