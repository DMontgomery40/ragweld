{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "p95 end-to-end retrieval latency (search, chat, benchmark, MCP) across the selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data: API not scraped",
          "mappings": [{ "type": "special", "options": { "match": "nan", "result": { "text": "No traffic" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(tribrid_search_latency_seconds_bucket[$__range])))",
          "legendFormat": "p95",
          "instant": true
        }
      ],
      "title": "Search latency p95 (selected range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Retrievals per second over the last 5 minutes.",
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "noValue": "No data: API not scraped" } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(tribrid_search_requests_total[5m]))", "legendFormat": "searches/s" }],
      "title": "Search rate (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Share of retrievals that completed without error across the selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "No data: API not scraped",
          "mappings": [{ "type": "special", "options": { "match": "nan", "result": { "text": "No traffic" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] }
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - sum(increase(tribrid_search_errors_total[$__range])) / sum(increase(tribrid_search_requests_total[$__range]))",
          "legendFormat": "success",
          "instant": true
        }
      ],
      "title": "Search success rate (selected range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Rolling 15-minute p95 of each retrieval leg, the reranker, and the whole retrieval. Rerank runs after fusion, so it adds to the slowest leg. Gaps mean no searches in that window.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "auto", "spanNulls": false },
          "unit": "s",
          "noValue": "No searches in range"
        }
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 7 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(tribrid_vector_leg_latency_seconds_bucket[15m])))", "legendFormat": "vector leg" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(tribrid_sparse_leg_latency_seconds_bucket[15m])))", "legendFormat": "sparse leg" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(tribrid_graph_leg_latency_seconds_bucket[15m])))", "legendFormat": "graph leg" },
        { "refId": "D", "expr": "histogram_quantile(0.95, sum by (le) (rate(tribrid_search_stage_latency_seconds_bucket{stage=\"rerank\"}[15m])))", "legendFormat": "rerank" },
        { "refId": "E", "expr": "histogram_quantile(0.95, sum by (le) (rate(tribrid_search_latency_seconds_bucket[15m])))", "legendFormat": "end to end" }
      ],
      "title": "Retrieval latency by leg, rerank, and end to end (rolling 15m p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Chunk rows indexed in each corpus now, refreshed from the registry at most every 5 minutes.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "No data: no per-corpus index size reported since the API began emitting them", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 16 },
      "id": 5,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "max by (corpus) (tribrid_corpus_chunks)", "legendFormat": "{{corpus}}", "instant": true }],
      "title": "Indexed chunks by corpus",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Graph entities in each corpus's active graph generation, refreshed at most every 5 minutes. A corpus without a graph has no bar.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "No data: no per-corpus graph size reported since the API began emitting them", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 16 },
      "id": 6,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "max by (corpus) (tribrid_corpus_graph_entities)", "legendFormat": "{{corpus}}", "instant": true }],
      "title": "Graph entities by corpus",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Entity-to-entity relationships in each corpus's active graph generation, refreshed at most every 5 minutes. A corpus without a graph has no bar.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "No data: no per-corpus graph size reported since the API began emitting them", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 16 },
      "id": 7,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "max by (corpus) (tribrid_corpus_graph_relationships)", "legendFormat": "{{corpus}}", "instant": true }],
      "title": "Graph relationships by corpus",
      "type": "bargauge"
    }
  ],
