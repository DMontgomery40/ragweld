      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 29 },
      "id": 14,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(tribrid_feedback_events_total{signal=\"thumbsdown\"}[$__range])) or on() (0 * sum(increase(tribrid_feedback_events_total{signal=~\"thumbsup|thumbsdown\"}[$__range])))) / sum(increase(tribrid_feedback_events_total{signal=~\"thumbsup|thumbsdown\"}[$__range]))",
