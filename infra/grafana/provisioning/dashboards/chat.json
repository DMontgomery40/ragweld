      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 29 },
      "id": 13,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "sum by (signal, surface) (increase(tribrid_feedback_events_total[$__range])) > 0", "legendFormat": "{{signal}} ({{surface}})", "instant": true }],
      "title": "Feedback events by signal and surface (selected range)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Thumbs-down votes over all thumbs votes (up and down) in the selected range, chat and search together.",
      "fieldConfig": {
