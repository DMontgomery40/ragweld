   "id": 3,
   "options": {
    "content": "## Frontend / RUM\nLive browser telemetry from the workbench: the Faro Web SDK ships errors, web vitals, and session events to the Alloy `faro.receiver`, which labels them `ragweld_service=web` / `deployment_runtime=browser` and forwards logs to Loki and traces to Tempo. The panels below read that real stream.",
    "mode": "markdown"
   },
   "title": "Operator Notes",
   "type": "text"
  },
  {
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    }
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "id": 4,
   "targets": [
    {
     "expr": "sum by (kind) (count_over_time({ragweld_service=\"web\"} | logfmt [1m]))",
     "legendFormat": "{{kind}}"
    }
   ],
   "title": "RUM events/min by kind (Faro via Loki)",
   "type": "timeseries"
  },
  {
   "datasource": {
    "type": "loki",
