    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Browser-measured duration of each user journey across the selected range: app load to a ready chat composer, chat send to status / first text / done, and conversation switch.",
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "min": 0, "noValue": "No browser sent a journey timing in range", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "id": 11,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [
        { "refId": "A", "expr": "quantile_over_time(0.5, {ragweld_service=\"web\"} |= \"kind=measurement\" | logfmt | type=~\"app_load_to_composer_ready|chat_send_to_status|chat_send_to_first_text|chat_send_to_done|conversation_switch\" | unwrap duration_ms | __error__=\"\" [$__range]) by (type)", "legendFormat": "{{type}} p50", "instant": true, "queryType": "instant" },
        { "refId": "B", "expr": "quantile_over_time(0.95, {ragweld_service=\"web\"} |= \"kind=measurement\" | logfmt | type=~\"app_load_to_composer_ready|chat_send_to_status|chat_send_to_first_text|chat_send_to_done|conversation_switch\" | unwrap duration_ms | __error__=\"\" [$__range]) by (type)", "legendFormat": "{{type}} p95", "instant": true, "queryType": "instant" }
      ],
      "title": "Journey duration p50 and p95 by journey (selected range)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Browser-measured chat send to status, to first answer text and to done, split by gateway alias and outcome, across the selected range.",
      "fieldConfig": { "defaults": { "unit": "ms", "decimals": 0, "min": 0, "noValue": "No browser sent a chat timing in range", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "id": 12,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [
        { "refId": "A", "expr": "quantile_over_time(0.5, {ragweld_service=\"web\"} |= \"kind=measurement\" | logfmt | type=~\"chat_send_to_status|chat_send_to_first_text|chat_send_to_done\" | unwrap duration_ms | __error__=\"\" [$__range]) by (type, context_model, context_outcome)", "legendFormat": "{{type}} {{context_model}} {{context_outcome}} p50", "instant": true, "queryType": "instant" },
        { "refId": "B", "expr": "quantile_over_time(0.95, {ragweld_service=\"web\"} |= \"kind=measurement\" | logfmt | type=~\"chat_send_to_status|chat_send_to_first_text|chat_send_to_done\" | unwrap duration_ms | __error__=\"\" [$__range]) by (type, context_model, context_outcome)", "legendFormat": "{{type}} {{context_model}} {{context_outcome}} p95", "instant": true, "queryType": "instant" }
      ],
      "title": "Chat send to status, first text and done: p50 and p95 by model and outcome (selected range)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Layout shifts reported per interval by the page region that moved and the page phase (load, stream, idle). Browsers report a 50% sample, rate-limited, so read the shape, not the absolute count.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "auto", "spanNulls": false, "stacking": { "mode": "none" } },
          "unit": "short",
          "noValue": "No layout shift reported in range"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 13,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (event_data_region, event_data_phase) (count_over_time({ragweld_service=\"web\"} |= \"layout_shift\" | logfmt | event_name=\"layout_shift\" [$__interval]))", "legendFormat": "{{event_data_region}} / {{event_data_phase}}", "queryType": "range" }
      ],
      "title": "Layout shifts by region and phase (sampled)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Summed layout-shift score in the selected range by the page region that moved and the page phase. From the 50% sample, so roughly half the real total.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3, "min": 0, "noValue": "No layout shift reported in range", "color": { "mode": "fixed", "fixedColor": "orange" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 14,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [
        { "refId": "A", "expr": "sum by (event_data_region, event_data_phase) (sum_over_time({ragweld_service=\"web\"} |= \"layout_shift\" | logfmt | event_name=\"layout_shift\" | unwrap event_data_value | __error__=\"\" [$__range]))", "legendFormat": "{{event_data_region}} / {{event_data_phase}}", "instant": true, "queryType": "instant" }
      ],
      "title": "Layout shift score by region and phase (selected range, sampled)",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "API requests (fetch / XHR) the workbench made from real browsers across the selected range, reported by the Faro SDK.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "No browser sent RUM in range" } },
