{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "p95 end-to-end retrieval latency (search, chat, benchmark, MCP) across the selected range.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data: API not scraped",
          "mappings": [{ "type": "special", "options": { "match": "nan", "result": { "text": "No traffic" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 }] }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (increase(tribrid_search_latency_seconds_bucket[$__range])))",
          "legendFormat": "p95",
          "instant": true
        }
      ],
      "title": "Search latency p95 (selected range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Retrievals per second over the last 5 minutes.",
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "noValue": "No data: API not scraped" } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{ "refId": "A", "expr": "sum(rate(tribrid_search_requests_total[5m]))", "legendFormat": "searches/s" }],
      "title": "Search rate (5m)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Indexing runs started and runs that ended in error across the selected range.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "No data: API not scraped" } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 11,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(tribrid_index_runs_total[$__range]))", "legendFormat": "runs", "instant": true },
        { "refId": "B", "expr": "sum(increase(tribrid_index_errors_total[$__range]))", "legendFormat": "failed", "instant": true }
      ],
      "title": "Index runs (selected range)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Rolling 15-minute median of each retrieval leg and the reranker. Gaps mean no searches in that window.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "auto", "spanNulls": false },
          "unit": "s",
          "noValue": "No searches in range"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(tribrid_vector_leg_latency_seconds_bucket[15m])))", "legendFormat": "vector leg" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le) (rate(tribrid_sparse_leg_latency_seconds_bucket[15m])))", "legendFormat": "sparse leg" },
        { "refId": "C", "expr": "histogram_quantile(0.50, sum by (le) (rate(tribrid_graph_leg_latency_seconds_bucket[15m])))", "legendFormat": "graph leg" },
        { "refId": "D", "expr": "histogram_quantile(0.50, sum by (le) (rate(tribrid_search_stage_latency_seconds_bucket{stage=\"rerank\"}[15m])))", "legendFormat": "rerank" }
      ],
      "title": "Retrieval latency by leg and rerank (rolling 15m p50)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Rolling 15-minute p95 of every search stage the API reports (embedding, Qdrant dense and sparse, graph traversal, chunk hydration, fusion, scoring, rerank). The top histogram bucket is 10 s, so a value of 10 s means 10 s or more.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "auto", "spanNulls": false },
          "unit": "s",
          "noValue": "No searches in range"
        }
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(tribrid_search_stage_latency_seconds_bucket[15m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "title": "Search stage latency (rolling 15m p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Errors per second by search stage (5m rate). A leg error means that leg returned nothing while the others still answered.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "unit": "ops",
          "noValue": "No data: API not scraped"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [{ "refId": "A", "expr": "sum by (stage) (rate(tribrid_search_stage_errors_total[5m]))", "legendFormat": "{{stage}}" }],
      "title": "Search stage error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Files, chunks and tokens processed per second while an indexing run is active (flat at zero otherwise).",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false },
          "unit": "ops",
          "noValue": "No data: API not scraped"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 31 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tribrid_index_files_processed_total[5m]))", "legendFormat": "files/s" },
        { "refId": "B", "expr": "sum(rate(tribrid_index_chunks_created_total[5m]))", "legendFormat": "chunks/s" },
        { "refId": "C", "expr": "sum(rate(tribrid_index_tokens_total[5m]))", "legendFormat": "tokens/s" }
      ],
      "title": "Index throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Rolling 15-minute p95 of every indexing stage the API reports (file collection and reads, chunking, embedding, Postgres/Qdrant/Neo4j writes, generation commit). Only filled while an indexing run is active.",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "auto", "spanNulls": false },
          "unit": "s",
          "noValue": "No indexing run in range"
        }
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 39 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["max", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(tribrid_index_stage_latency_seconds_bucket[15m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "title": "Index stage latency (rolling 15m p95)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Chunk rows indexed in each corpus now, refreshed from the registry at most every 5 minutes.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "No data: no per-corpus index size reported since the API began emitting them", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 48 },
      "id": 8,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "max by (corpus) (tribrid_corpus_chunks)", "legendFormat": "{{corpus}}", "instant": true }],
      "title": "Indexed chunks by corpus",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Graph entities in each corpus's active graph generation, refreshed at most every 5 minutes. A corpus without a graph has no bar.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "No data: no per-corpus graph size reported since the API began emitting them", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 48 },
      "id": 9,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "max by (corpus) (tribrid_corpus_graph_entities)", "legendFormat": "{{corpus}}", "instant": true }],
      "title": "Graph entities by corpus",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Entity-to-entity relationships in each corpus's active graph generation, refreshed at most every 5 minutes. A corpus without a graph has no bar.",
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "min": 0, "noValue": "No data: no per-corpus graph size reported since the API began emitting them", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 48 },
      "id": 10,
      "options": { "displayMode": "basic", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "valueMode": "text" },
      "targets": [{ "refId": "A", "expr": "max by (corpus) (tribrid_corpus_graph_relationships)", "legendFormat": "{{corpus}}", "instant": true }],
      "title": "Graph relationships by corpus",
      "type": "bargauge"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["tribrid", "rag"],
